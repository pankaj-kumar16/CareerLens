# CareerLens - Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit real credentials or .env to version control.

# Application Configuration
APP_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173

# Database (MongoDB Atlas for production, local MongoDB for development)
MONGODB_URI=mongodb://localhost:27017/careerlens
MONGODB_DATABASE=careerlens

# JWT Authentication
# Must be a strong secret of at least 256 bits (32+ chars / base64)
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_KEY_MIN_256_BITS
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated list of allowed frontend domains)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Email Service (SMTP Configuration for OTP & Notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com

# AI Service (OpenAI / HuggingFace / Fallback local semantic matching)
AI_PROVIDER=openai
AI_MODEL=gpt-3.5-turbo
AI_API_KEY=your-ai-api-key-here

# File Storage Configuration (local or s3)
STORAGE_TYPE=local
LOCAL_UPLOAD_PATH=./uploads

# AWS S3 Resume Storage (Required when STORAGE_TYPE=s3)
AWS_REGION=us-east-1
AWS_S3_BUCKET=careerlens-resumes-private
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# Frontend Environment Variables (Vite)
# Add this to frontend/.env or runtime environment
VITE_API_BASE_URL=http://localhost:8080

