import { useState } from 'react'
import { motion } from 'framer-motion'
import { Link, useNavigate } from 'react-router-dom'
import {
  FileText, Search, BarChart2, CheckCircle, ArrowRight,
  UploadCloud, Sparkles, Filter, Compass, MapPin
} from 'lucide-react'
import Navbar from '../components/Navbar'
import Footer from '../components/Footer'
import { useAuth } from '../context/AuthContext'

const howItWorks = [
  {
    step: '01',
    icon: UploadCloud,
    title: 'Upload your resume',
    description: 'Upload a PDF or DOCX resume. CareerLens parses it and extracts your skills, experience, and education.',
  },
  {
    step: '02',
    icon: Search,
    title: 'Browse job listings',
    description: 'Search and filter live jobs by role, location, salary, and work mode.',
  },
  {
    step: '03',
    icon: Sparkles,
    title: 'See your match score',
    description: 'For each job, view a detailed compatibility score based on skills, experience, and requirements.',
  },
  {
    step: '04',
    icon: FileText,
    title: 'Apply and track',
    description: 'Apply directly and track status updates as recruiters review your application.',
  },
]

const seekerBenefits = [
  'Understand how your resume aligns with job requirements',
  'See detailed skill gap analysis for each role',
  'Track all your applications in one place',
]

const recruiterBenefits = [
  'Rank candidates by resume–job match quality',
  'Filter applicants by skills, experience, and score',
  'Streamline shortlisting with a clear pipeline',
]

export default function HomePage() {
  const { isAuthenticated, user } = useAuth()
  const navigate = useNavigate()
  const [keyword, setKeyword] = useState('')
  const [location, setLocation] = useState('')

  const dashboardLink = user?.role === 'RECRUITER'
    ? '/recruiter/dashboard'
    : '/seeker/dashboard'

  const handleHeroSearch = (e) => {
    e.preventDefault()
    const params = new URLSearchParams()
    if (keyword.trim()) params.set('q', keyword.trim())
    if (location.trim()) params.set('location', location.trim())
    
    // Always route to public /jobs for guest search
    const targetRoute = isAuthenticated && user?.role === 'JOB_SEEKER'
      ? '/applicant/jobs'
      : '/jobs'
    navigate(`${targetRoute}?${params.toString()}`)
  }

  return (
    <div className="cl-page">
      <Navbar />

      <main>
        {/* ── Photographic Hero (Acro Claims Visual Reference) ─────────────── */}
        <section className="relative overflow-hidden text-white min-h-[520px] flex items-center">
          {/* Background Image — Natural Photograph */}
          <div
            className="absolute inset-0 bg-cover bg-center bg-no-repeat transition-transform duration-1000 scale-105"
            style={{ backgroundImage: "url('/images/login_laptop_bg.png')" }}
          />
          {/* Full-section dark overlay on hero background image for text readability */}
          <div className="absolute inset-0 bg-black/45 pointer-events-none" />

          <div className="relative z-10 max-w-[76rem] mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-28 w-full">
            <motion.div
              initial={{ opacity: 0, y: 16 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ duration: 0.4 }}
              className="max-w-3xl"
            >
              <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/20 border border-emerald-400/30 text-xs font-semibold text-emerald-400 mb-4 font-mono">
                <span className="w-2 h-2 rounded-full bg-emerald-400" />
                INTEL &amp; CAREER MATCHING PORTAL
              </div>

              <h1 className="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-[1.15] mb-4">
                Connecting talent with precision job matching, start to finish.
              </h1>

              <p className="text-base sm:text-lg text-gray-200 leading-relaxed mb-8 max-w-2xl">
                CareerLens helps job seekers understand how their resumes align with role requirements,
                and enables recruiters to identify qualified candidates efficiently.
              </p>

              {/* Hero Search Bar */}
              <form
                onSubmit={handleHeroSearch}
                className="bg-white/95 backdrop-blur-md p-2.5 sm:p-3 rounded-xl shadow-2xl border border-white/40 max-w-2xl mb-8"
              >
                <div className="grid grid-cols-1 sm:grid-cols-12 gap-2.5 items-center">
                  <div className="sm:col-span-5 cl-input-group">
                    <label htmlFor="home-search-keyword" className="sr-only">Job title or keyword</label>
                    <div className="cl-input-icon-left">
                      <Search className="w-4 h-4 text-[#8F9992]" />
                    </div>
                    <input
                      id="home-search-keyword"
                      type="text"
                      placeholder="Title or keyword…"
                      value={keyword}
                      onChange={(e) => setKeyword(e.target.value)}
                      className="cl-input cl-input-with-icon text-sm bg-white border-[#E4E2DB] text-[#1B211D] focus:border-[#0E5C34]"
                    />
                  </div>

                  <div className="sm:col-span-4 cl-input-group">
                    <label htmlFor="home-search-location" className="sr-only">Location or remote</label>
                    <div className="cl-input-icon-left">
                      <MapPin className="w-4 h-4 text-[#8F9992]" />
                    </div>
                    <input
                      id="home-search-location"
                      type="text"
                      placeholder="Location or remote…"
                      value={location}
                      onChange={(e) => setLocation(e.target.value)}
                      className="cl-input cl-input-with-icon text-sm bg-white border-[#E4E2DB] text-[#1B211D] focus:border-[#0E5C34]"
                    />
                  </div>

                  <div className="sm:col-span-3">
                    <button
                      type="submit"
                      className="cl-btn-primary w-full py-2.5 text-sm font-semibold shadow-md bg-[#0E5C34] hover:bg-[#0A4527] text-white"
                    >
                      Search jobs
                    </button>
                  </div>
                </div>
              </form>

              <div className="flex flex-col sm:flex-row gap-3">
                {isAuthenticated ? (
                  <Link to={dashboardLink} className="cl-btn-primary px-6 py-3 text-sm font-semibold shadow-lg">
                    Go to your dashboard
                    <ArrowRight className="w-4 h-4" />
                  </Link>
                ) : (
                  <>
                    <Link to="/applicant/jobs" className="cl-btn-primary px-6 py-3 text-sm font-semibold shadow-lg">
                      Explore jobs
                      <ArrowRight className="w-4 h-4" />
                    </Link>
                    <Link to="/register" className="cl-btn-secondary px-6 py-3 text-sm font-semibold bg-white hover:bg-gray-100 text-[#1B211D] border-gray-200 shadow-sm">
                      Create your profile
                    </Link>
                  </>
                )}
              </div>

              {/* Acro Claims Trust Row Metrics */}
              <div className="flex flex-wrap gap-8 pt-8 border-t border-white/20 mt-12">
                <div>
                  <div className="text-2xl font-bold text-emerald-400 mono">100%</div>
                  <div className="text-xs text-gray-300 mt-0.5">Automated skill parsing</div>
                </div>
                <div>
                  <div className="text-2xl font-bold text-emerald-400 mono">AI-Ranked</div>
                  <div className="text-xs text-gray-300 mt-0.5">Candidate matching</div>
                </div>
                <div>
                  <div className="text-2xl font-bold text-emerald-400 mono">Real-time</div>
                  <div className="text-xs text-gray-300 mt-0.5">Application tracking</div>
                </div>
              </div>
            </motion.div>
          </div>
        </section>

        {/* ── How it works ──────────────────────────────────────────────── */}
        <section className="border-b border-[#E4E2DB] bg-[#F6F5F1]">
          <div className="max-w-[76rem] mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
            <div className="mb-10">
              <div className="cl-eyebrow mb-1">HOW IT WORKS</div>
              <h2 className="text-2xl sm:text-3xl font-bold text-[#1B211D]">
                From upload to application in four steps
              </h2>
            </div>

            <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
              {howItWorks.map((step, i) => (
                <motion.div
                  key={step.step}
                  initial={{ opacity: 0, y: 14 }}
                  whileInView={{ opacity: 1, y: 0 }}
                  viewport={{ once: true }}
                  transition={{ duration: 0.3, delay: i * 0.05 }}
                  className="cl-card p-6 flex flex-col justify-between"
                >
                  <div className="space-y-3">
                    <div className="flex items-center justify-between">
                      <div className="w-9 h-9 rounded-lg bg-[#EAF5EE] border border-[#B9E3C6] flex items-center justify-center">
                        <step.icon className="w-4.5 h-4.5 text-[#0E5C34]" aria-hidden="true" />
                      </div>
                      <span className="text-xs font-bold text-[#5B655E] mono tracking-wider">
                        {step.step}
                      </span>
                    </div>
                    <h3 className="text-base font-bold text-[#1B211D]">{step.title}</h3>
                    <p className="text-xs text-[#5B655E] leading-relaxed">{step.description}</p>
                  </div>
                </motion.div>
              ))}
            </div>
          </div>
        </section>

        {/* ── For seekers & recruiters ──────────────────────────────────── */}
        <section className="border-b border-[#E4E2DB] bg-white">
          <div className="max-w-[76rem] mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
            <div className="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">

              {/* Job seekers */}
              <motion.div
                initial={{ opacity: 0, y: 16 }}
                whileInView={{ opacity: 1, y: 0 }}
                viewport={{ once: true }}
                transition={{ duration: 0.35 }}
                className="cl-card p-8"
              >
                <div className="w-10 h-10 rounded-lg bg-[#EAF5EE] flex items-center justify-center mb-5">
                  <Search className="w-5 h-5 text-[#0E5C34]" />
                </div>
                <h3 className="text-xl font-semibold text-[#1B211D] mb-2">
                  Discover relevant jobs
                </h3>
                <p className="text-sm text-[#5B655E] mb-6 leading-relaxed">
                  Upload your resume once and understand exactly how well it matches each job
                  before you apply.
                </p>
                <ul className="space-y-3 mb-7">
                  {seekerBenefits.map(b => (
                    <li key={b} className="flex items-start gap-2.5 text-sm text-[#3A4139]">
                      <CheckCircle className="w-4 h-4 text-[#0E5C34] shrink-0 mt-0.5" />
                      {b}
                    </li>
                  ))}
                </ul>
                <Link
                  to="/register"
                  className="inline-flex items-center gap-1.5 text-sm font-semibold text-[#0E5C34] hover:text-[#0A4527] transition-colors group"
                >
                  Get started as a job seeker
                  <ArrowRight className="w-4 h-4 group-hover:translate-x-0.5 transition-transform" />
                </Link>
              </motion.div>

              {/* Recruiters */}
              <motion.div
                initial={{ opacity: 0, y: 16 }}
                whileInView={{ opacity: 1, y: 0 }}
                viewport={{ once: true }}
                transition={{ duration: 0.35, delay: 0.08 }}
                className="cl-card p-8"
              >
                <div className="w-10 h-10 rounded-lg bg-[#EAF5EE] flex items-center justify-center mb-5">
                  <BarChart2 className="w-5 h-5 text-[#0E5C34]" />
                </div>
                <h3 className="text-xl font-semibold text-[#1B211D] mb-2">
                  Find suitable candidates
                </h3>
                <p className="text-sm text-[#5B655E] mb-6 leading-relaxed">
                  Post job listings and receive AI-ranked candidates sorted by how closely their
                  resumes match your requirements.
                </p>
                <ul className="space-y-3 mb-7">
                  {recruiterBenefits.map(b => (
                    <li key={b} className="flex items-start gap-2.5 text-sm text-[#3A4139]">
                      <CheckCircle className="w-4 h-4 text-[#0E5C34] shrink-0 mt-0.5" />
                      {b}
                    </li>
                  ))}
                </ul>
                <Link
                  to="/register"
                  className="inline-flex items-center gap-1.5 text-sm font-semibold text-[#0E5C34] hover:text-[#0A4527] transition-colors group"
                >
                  Get started as a recruiter
                  <ArrowRight className="w-4 h-4 group-hover:translate-x-0.5 transition-transform" />
                </Link>
              </motion.div>
            </div>
          </div>
        </section>

        {/* ── CTA band ──────────────────────────────────────────────────── */}
        {!isAuthenticated && (
          <section className="bg-[#F6F5F1]">
            <div className="max-w-[76rem] mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
              <div className="flex flex-col sm:flex-row items-center justify-between gap-6">
                <div>
                  <h2 className="text-xl sm:text-2xl font-semibold text-[#1B211D]">
                    Ready to get started?
                  </h2>
                  <p className="text-sm text-[#5B655E] mt-1">
                    Create a free account and start matching your resume to real job listings.
                  </p>
                </div>
                <div className="flex items-center gap-3 shrink-0">
                  <Link to="/login" className="cl-btn-secondary px-5 py-2.5 text-sm">
                    Sign in
                  </Link>
                  <Link to="/register" className="cl-btn-primary px-5 py-2.5 text-sm">
                    Create account <ArrowRight className="w-4 h-4" />
                  </Link>
                </div>
              </div>
            </div>
          </section>
        )}
      </main>

      <Footer />
    </div>
  )
}
