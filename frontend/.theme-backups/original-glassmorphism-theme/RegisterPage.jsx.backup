import { useState } from 'react'
import { motion } from 'framer-motion'
import { Link, useNavigate } from 'react-router-dom'
import {
  UserCheck, Briefcase, Mail, Phone, User, ArrowRight,
  AlertCircle, ShieldCheck, CheckCircle2
} from 'lucide-react'
import Navbar from '../components/Navbar'
import Footer from '../components/Footer'
import VerifyOtpModal from '../components/VerifyOtpModal'
import { useAuth } from '../context/AuthContext'
import { authApi } from '../services/api'

export default function RegisterPage() {
  const navigate = useNavigate()
  const { registerVerifyOtp } = useAuth()

  const [formData, setFormData] = useState({
    fullName: '',
    email: '',
    phone: '',
    role: 'JOB_SEEKER',
  })
  const [loading, setLoading] = useState(false)
  const [error, setError] = useState('')
  const [showOtpModal, setShowOtpModal] = useState(false)

  const handleChange = (e) => {
    setFormData(prev => ({ ...prev, [e.target.name]: e.target.value }))
    if (error) setError('')
  }

  const handleRoleSelect = (role) => {
    setFormData(prev => ({ ...prev, role }))
    if (error) setError('')
  }

  const handleSubmit = async (e) => {
    e.preventDefault()
    if (!formData.fullName.trim()) {
      setError('Please enter your full name.')
      return
    }
    if (!formData.email.trim()) {
      setError('Please enter your email address.')
      return
    }

    setLoading(true)
    setError('')

    try {
      await authApi.registerSendOtp({
        email: formData.email,
        role: formData.role,
        fullName: formData.fullName,
      })
      setShowOtpModal(true)
    } catch (err) {
      setError(err?.response?.data?.message || err?.message || 'Failed to send verification code. Please try again.')
    } finally {
      setLoading(false)
    }
  }

  const handleOtpVerified = (userData) => {
    setShowOtpModal(false)
    if (userData.role === 'RECRUITER') {
      navigate('/recruiter/dashboard')
    } else {
      navigate('/seeker/dashboard')
    }
  }

  const isSeeker = formData.role === 'JOB_SEEKER'
  const isRecruiter = formData.role === 'RECRUITER'

  return (
    <div className="min-h-screen flex flex-col bg-[#F6F5F1] text-[#1B211D]">
      <Navbar />

      {/* ── Split-Screen Layout (72% Left Hero / 28% Right Panel) ───────────── */}
      <main className="flex-1 relative flex flex-col lg:flex-row overflow-hidden min-h-[calc(100vh-65px)]">
        
        {/* Full-width Split Background Image — Natural Photograph */}
        <div
          className="absolute inset-0 bg-cover bg-center bg-no-repeat pointer-events-none"
          style={{ backgroundImage: "url('/images/login_laptop_bg.png')" }}
        />
        {/* Subtle full-section dark overlay on left hero section for white text readability */}
        <div className="absolute inset-0 lg:w-[72%] bg-black/45 pointer-events-none" />

        {/* Left Hero Content (72% width) */}
        <div className="relative z-10 w-full lg:w-[72%] p-8 sm:p-14 lg:p-20 flex flex-col justify-end text-white min-h-[380px] lg:min-h-full">
          <motion.div
            initial={{ opacity: 0, y: 16 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ duration: 0.4 }}
            className="max-w-2xl"
          >
            <div className="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-emerald-400 mb-3 font-mono">
              <span className="w-2.5 h-2.5 rounded-full bg-emerald-400" />
              INTELLIGENT RECRUITMENT PORTAL
            </div>
            
            <h1 className="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white leading-tight mb-4 tracking-tight">
              Join CareerLens &amp; unlock<br />
              AI job matching.
            </h1>
            
            <p className="text-sm sm:text-base text-gray-200 leading-relaxed max-w-xl mb-8">
              Create your account to start evaluating role compatibility, building targeted resumes, and applying to top positions.
            </p>

            {/* Value Propositions */}
            <div className="pt-6 border-t border-white/20 grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs font-semibold text-white">
              <div className="flex items-center gap-2">
                <CheckCircle2 className="w-4 h-4 text-emerald-400 shrink-0" />
                <span>Automated skill parsing</span>
              </div>
              <div className="flex items-center gap-2">
                <CheckCircle2 className="w-4 h-4 text-emerald-400 shrink-0" />
                <span>AI-ranked match score</span>
              </div>
              <div className="flex items-center gap-2">
                <CheckCircle2 className="w-4 h-4 text-emerald-400 shrink-0" />
                <span>Free account setup</span>
              </div>
            </div>
          </motion.div>
        </div>

        {/* Right Translucent Register Panel (28% width) */}
        <div className="relative z-10 w-full lg:w-[28%] min-w-[360px] auth-form-panel p-6 sm:p-10 flex flex-col justify-center shrink-0">
          <motion.div
            initial={{ opacity: 0, y: 14 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ duration: 0.35 }}
            className="w-full"
          >
            {/* Form Header */}
            <div className="mb-5">
              <div className="w-10 h-10 rounded-[4px] bg-[#0E5C34]/10 border border-[#0E5C34]/20 flex items-center justify-center text-[#0E5C34] mb-3 shadow-sm">
                <ShieldCheck className="w-5 h-5 text-[#0E5C34]" />
              </div>
              <h2 className="text-2xl font-bold text-[#1B211D]">Create your account</h2>
              <p className="text-xs text-[#5B655E] mt-1">
                Fill in your details below to get started with CareerLens.
              </p>
            </div>

            {/* Role selector */}
            <fieldset className="mb-4">
              <legend className="text-xs font-semibold text-[#1B211D] mb-2">I'm joining as a</legend>
              <div className="grid grid-cols-2 gap-2.5">
                <button
                  type="button"
                  id="role-seeker"
                  onClick={() => handleRoleSelect('JOB_SEEKER')}
                  aria-pressed={isSeeker}
                  className={[
                    'p-2.5 rounded-[4px] border text-left transition-all flex items-center gap-2',
                    isSeeker
                      ? 'bg-[#0E5C34] border-[#0E5C34] text-white shadow-sm'
                      : 'bg-white border-[#E4E2DB] text-[#3A4139] hover:border-[#0E5C34]/40',
                  ].join(' ')}
                >
                  <UserCheck className={`w-4 h-4 shrink-0 ${isSeeker ? 'text-white' : 'text-[#0E5C34]'}`} />
                  <div>
                    <div className={`text-xs font-bold ${isSeeker ? 'text-white' : 'text-[#1B211D]'}`}>
                      Job Seeker
                    </div>
                    <div className={`text-[10px] ${isSeeker ? 'text-[#EAF5EE]' : 'text-[#5B655E]'}`}>Looking for work</div>
                  </div>
                </button>

                <button
                  type="button"
                  id="role-recruiter"
                  onClick={() => handleRoleSelect('RECRUITER')}
                  aria-pressed={isRecruiter}
                  className={[
                    'p-2.5 rounded-[4px] border text-left transition-all flex items-center gap-2',
                    isRecruiter
                      ? 'bg-[#0E5C34] border-[#0E5C34] text-white shadow-sm'
                      : 'bg-white border-[#E4E2DB] text-[#3A4139] hover:border-[#0E5C34]/40',
                  ].join(' ')}
                >
                  <Briefcase className={`w-4 h-4 shrink-0 ${isRecruiter ? 'text-white' : 'text-[#0E5C34]'}`} />
                  <div>
                    <div className={`text-xs font-bold ${isRecruiter ? 'text-white' : 'text-[#1B211D]'}`}>
                      Recruiter
                    </div>
                    <div className={`text-[10px] ${isRecruiter ? 'text-[#EAF5EE]' : 'text-[#5B655E]'}`}>Hiring talent</div>
                  </div>
                </button>
              </div>
            </fieldset>

            {error && (
              <div className="cl-alert cl-alert-error mb-4" role="alert">
                <AlertCircle className="w-4 h-4 shrink-0 mt-0.5" />
                <span className="text-xs font-medium">{error}</span>
              </div>
            )}

            <form onSubmit={handleSubmit} className="space-y-3" noValidate>
              <div>
                <label htmlFor="register-name" className="text-xs font-semibold text-[#1B211D] mb-1 block">Full name</label>
                <div className="cl-input-group">
                  <div className="cl-input-icon-left">
                    <User className="w-4 h-4" />
                  </div>
                  <input
                    type="text"
                    name="fullName"
                    id="register-name"
                    required
                    autoComplete="name"
                    value={formData.fullName}
                    onChange={handleChange}
                    placeholder="Your full name"
                    className="cl-input cl-input-with-icon text-sm bg-white text-[#1B211D] border-[#E4E2DB] focus:border-[#0E5C34]"
                  />
                </div>
              </div>

              <div>
                <label htmlFor="register-email" className="text-xs font-semibold text-[#1B211D] mb-1 block">Email address</label>
                <div className="cl-input-group">
                  <div className="cl-input-icon-left">
                    <Mail className="w-4 h-4" />
                  </div>
                  <input
                    type="email"
                    name="email"
                    id="register-email"
                    required
                    autoComplete="email"
                    value={formData.email}
                    onChange={handleChange}
                    placeholder="you@example.com"
                    className="cl-input cl-input-with-icon text-sm bg-white text-[#1B211D] border-[#E4E2DB] focus:border-[#0E5C34]"
                  />
                </div>
              </div>

              <div>
                <label htmlFor="register-phone" className="text-xs font-semibold text-[#1B211D] mb-1 block">
                  Phone number{' '}
                  <span className="text-[#5B655E] font-normal normal-case tracking-normal">
                    (optional)
                  </span>
                </label>
                <div className="cl-input-group">
                  <div className="cl-input-icon-left">
                    <Phone className="w-4 h-4" />
                  </div>
                  <input
                    type="tel"
                    name="phone"
                    id="register-phone"
                    autoComplete="tel"
                    value={formData.phone}
                    onChange={handleChange}
                    placeholder="+91 9876543210"
                    className="cl-input cl-input-with-icon text-sm bg-white text-[#1B211D] border-[#E4E2DB] focus:border-[#0E5C34]"
                  />
                </div>
              </div>

              <button
                type="submit"
                id="register-submit"
                disabled={loading}
                className="cl-btn-primary w-full justify-center py-2.5 text-sm font-semibold shadow-md bg-[#0E5C34] hover:bg-[#0A4527] text-white mt-1"
              >
                {loading ? 'Sending code…' : (
                  <>
                    Continue
                    <ArrowRight className="w-4 h-4" />
                  </>
                )}
              </button>
            </form>

            <div className="mt-5 pt-4 border-t border-[#E4E2DB] text-center text-xs text-[#5B655E]">
              Already have an account?{' '}
              <Link to="/login" className="cl-link font-bold text-[#0E5C34] hover:underline">
                Sign in
              </Link>
            </div>
          </motion.div>
        </div>
      </main>

      <Footer />

      <VerifyOtpModal
        isOpen={showOtpModal}
        onClose={() => setShowOtpModal(false)}
        email={formData.email}
        type="REGISTER"
        onSuccess={handleOtpVerified}
        verifyApi={(payload) => registerVerifyOtp({ ...payload, role: formData.role, fullName: formData.fullName, phone: formData.phone })}
      />
    </div>
  )
}
